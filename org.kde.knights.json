{
    "app-id": "org.kde.knights",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "knights",
    "rename-icon": "knights",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/share/carddecks",
        "/share/doc",
        "/share/gnuchess",
        "/share/info",
        "/share/man",
        "/share/qlogging-categories6"
    ],
    "modules": [
        {
            "name": "stockfish",
            "subdir": "src",
            "buildsystem": "simple",
            "build-options": {
                "arch": {
                    "x86_64": {
                        "env": {
                            "ARCH": "x86-64"
                        }
                    },
                    "aarch64": {
                        "env": {
                            "ARCH": "armv8"
                        }
                    }
                }
            },
            "build-commands": [
                "make -j $FLATPAK_BUILDER_N_JOBS build",
                "make install BINDIR=/app/bin"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/official-stockfish/Stockfish/archive/sf_18.tar.gz",
                    "sha256": "22a195567e3493e7c9ca8bf8fa2339f4ffc876384849ac8a417ff4b919607e7b",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 5750,
                        "url-template": "https://github.com/official-stockfish/Stockfish/archive/sf_$version.tar.gz"
                    }
                },
                {
                    "type": "file",
                    "dest": "src",
                    "url": "https://tests.stockfishchess.org/api/nn/nn-c288c895ea92.nnue",
                    "sha256": "c288c895ea924429ea9092e3f36b2b3c1f00f2a3a4c759ff7e57e79e3b43e4a7"
                },
                {
                    "type": "file",
                    "dest": "src",
                    "url": "https://tests.stockfishchess.org/api/nn/nn-37f18f62d772.nnue",
                    "sha256": "37f18f62d772f3107e1d6aaca3898c130c3c86f2ab63e6555fbbca20635a899d"
                }
            ]
        },
        {
            "name": "gnuchess",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ftpmirror.gnu.org/chess/gnuchess-6.3.0.tar.gz",
                    "sha256": "0b37bec2098c2ad695b7443e5d7944dc6dc8284f8d01fcc30bdb94dd033ca23a",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1206,
                        "stable-only": true,
                        "url-template": "https://ftpmirror.gnu.org/chess/gnuchess-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "libkdegames",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/libkdegames-26.08.0.tar.xz",
                    "sha256": "dfe92df0983d8344ba6544fe0071a8afe77b9af087cb4e42b2e4e9d70eed89cf",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/libkdegames-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "libplasma",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/plasma/6.7.4/libplasma-6.7.4.tar.xz",
                    "sha256": "8f187850ea0cd46e545b33787619fa28f682388e4b828d090a0692874a7c9955",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8761,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/plasma/$version/libplasma-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "knights",
            "buildsystem": "cmake-ninja",
            "post-install": [
                "install -Dm644 org.kde.knights.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/org.kde.knights.svg"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/knights-26.08.0.tar.xz",
                    "sha256": "266b1cdeeec159134bf4230f4aeefe8287e05e87f4d67a903c09832330ebe021",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/knights-$version.tar.xz"
                    }
                },
                {
                    "type": "file",
                    "url": "https://apps.kde.org/app-icons/org.kde.knights.svg",
                    "sha256": "e75d1b7f7b7b5d449f2058e63d0ca5f52e3593e0dc984f875e2bebde3e194b85"
                }
            ]
        }
    ]
}
